{
  "name": "saint-marys-control-academico",
  "version": "1.0.0",
  "description": "Sistema de Control Académico del College Saint Mary's: notas, asistencia, conducta y notificaciones a apoderados.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "seed:bulk": "node --env-file-if-exists=.env src/seed-bulk.js",
    "test": "node --test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1"
  }
}
