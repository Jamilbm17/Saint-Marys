rules_version = '2';

// Toda la lectura y escritura pasa por el servidor Express con firebase-admin (que ignora estas reglas).
// Se bloquea el acceso directo desde navegadores y apps con la configuración pública del proyecto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
