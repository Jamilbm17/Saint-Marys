# Copia este archivo a .env (no se sube a Git) y completa los valores.
# Ver README.md (sección Firebase)

PORT=3000

# --- Base de datos: Cloud Firestore -------------------------------------------------
# Sin credenciales la app usa memoria (solo para probar; los datos se pierden al reiniciar).
# Opción local: ruta al JSON de la cuenta de servicio descargado de Firebase.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Opción para Render/Railway: el mismo JSON en una sola línea (o en base64).
# FIREBASE_SERVICE_ACCOUNT_JSON=
# DATA_STORE=firestore        # fuerza firestore o memory
# AUTO_SEED=true              # carga los datos de demostración si Firestore está vacío

# --- Notificaciones push (Firebase Cloud Messaging) -----------------------------------
# Configuración PÚBLICA de la app web (Firebase > Configuración del proyecto > Tus apps)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
# Firebase > Configuración > Cloud Messaging > Certificados push web > Par de claves
FIREBASE_VAPID_KEY=
# FCM_ENABLED=false           # desactiva el envío de push sin quitar la configuración

# --- Producción (HTTPS) -----------------------------------------------------------------
# NODE_ENV=production         # cookie de sesión Secure
# TRUST_PROXY=1               # detrás de Render/Railway
